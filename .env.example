# Copy to .env (which is gitignored) and fill in. Only needed for `judge`.
# The CLI auto-loads this file; it never overrides a variable already exported.
ANTHROPIC_API_KEY=sk-ant-...

# --- expense-report ---------------------------------------------------------
# App-specific passwords ONLY — never your real account passwords.
# Preferred storage is the macOS Keychain (then you can omit these lines):
#   security add-generic-password -s expense-report -a you@icloud.com -w
#   security add-generic-password -s expense-report -a you@gmail.com -w
# iCloud: account.apple.com -> Sign-In & Security -> App-Specific Passwords
# Gmail:  myaccount.google.com/apppasswords (requires 2-Step Verification)
ICLOUD_EMAIL=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
